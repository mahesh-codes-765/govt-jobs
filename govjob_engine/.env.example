DATABASE_URL=sqlite:///./data/govjobs.db
REQUEST_TIMEOUT=45
CRAWL_DELAY_SECONDS=0.4
MAX_LISTING_PAGES=50

# LLM (Anthropic Haiku 4.5) — optional second-reader extraction layer.
# Leave LLM_ENABLED=false until you have a key; the pipeline works fine
# without it (deterministic extraction only, everything routes to review).
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MONTHLY_USD_CAP=5.0
LLM_SPEND_FILE=./data/llm_spend.json

# Web-search discovery — Claude searches the open web for notifications
# beyond the fixed site adapters (covers JS-only listing pages like
# SSC/RRB). Separate opt-in and separate budget cap from the extraction
# LLM above; uses the same LLM_API_KEY. Query list and schedule are set
# live from the admin dashboard, not here.
WEB_DISCOVERY_ENABLED=false
WEB_DISCOVERY_MODEL=claude-haiku-4-5-20251001
WEB_DISCOVERY_MONTHLY_USD_CAP=3.0

# Telegram human-review bot — long-poll, no webhook/port needed.
# TELEGRAM_CHAT_ID must be YOUR chat id; the bot only ever talks to it.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=2.0
CRAWL_POLL_INTERVAL_SECONDS=1800.0
